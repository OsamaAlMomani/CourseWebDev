# Copy this file to server/.env and fill in the real values. NEVER commit server/.env.
# Everything is required except the Stripe lines, but without Stripe the shop cannot take payments.

# PostgreSQL (Neon). Keep ?sslmode=require; the server upgrades it to verify-full.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# A long random string. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The website's public address (used by the auth library and as the Stripe return address).
BETTER_AUTH_URL=http://localhost:5173
# Where the browser is allowed to call the API from (comma-separated). Optional on the live host:
# the server already trusts its own site and the project's Vercel previews.
CLIENT_ORIGINS=http://localhost:5173

PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------- Stripe (test mode)
# Dashboard -> Developers -> API keys -> "Secret key" (starts with sk_test_ while you are in Test mode).
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> your endpoint -> "Signing secret" (starts with whsec_).
# Locally, `stripe listen --forward-to localhost:4000/api/stripe/webhook` prints one.
STRIPE_WEBHOOK_SECRET=
# ISO currency code. The shop's prices are in US dollars, so keep usd unless you re-price everything.
STRIPE_CURRENCY=usd
