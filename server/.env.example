# Copy this file to ".env" and fill it in. ".env" is git-ignored, this example file is not.

# Neon -> your project -> "Connect" -> copy the WHOLE connection string with the real password (keep ?sslmode=require).
# The values below are placeholders: replacing them is required, otherwise you get "password authentication failed".
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# A long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me

# The address people type in the browser (the FRONTEND). Locally: the Vite dev server.
# In production: your Vercel URL, e.g. https://globalbooks.vercel.app
BETTER_AUTH_URL=http://localhost:5173

# Origins allowed to call the API (comma separated). Normally the same as BETTER_AUTH_URL.
CLIENT_ORIGINS=http://localhost:5173

PORT=4000
